{
  "name": "journal-matcher",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=10 <12"
  },
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @journal-matcher/web",
    "dev:api": "python3.13 -m uvicorn journal_matcher_api.main:app --reload --app-dir apps/api/src --port 8000",
    "dev:worker": "python3.13 -m journal_matcher_worker.main",
    "health:worker": "PYTHONPATH=apps/worker/src python3.13 -m journal_matcher_worker.main --health-check",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && python3.13 -m ruff check apps tests",
    "typecheck": "npm run typecheck --workspaces --if-present && python3.13 -m mypy apps/api/src apps/worker/src",
    "test": "npm run test --workspaces --if-present && python3.13 -m pytest",
    "format": "prettier --write . && python3.13 -m ruff format apps tests",
    "format:check": "prettier --check . && python3.13 -m ruff format --check apps tests",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "infra:up": "docker compose -f infra/containers/compose.yaml up -d",
    "infra:down": "docker compose -f infra/containers/compose.yaml down",
    "infra:validate": "docker compose -f infra/containers/compose.yaml config --quiet",
    "test:python:docker": "docker build --target test -f apps/api/Dockerfile .",
    "test:javascript:docker": "docker build --target quality -f apps/web/Dockerfile .",
    "test:containers": "sh scripts/smoke-containers.sh",
    "scan:images": "sh scripts/scan-images.sh"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
